                    }
                }
            ]
        },
        {
            "name": "kigo",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.1/src/kigo-26.04.1.tar.xz",
                    "sha256": "dc6a067756753da5e6fb6c051f87a2abd806cd04a534b1ac852c3854a5d9ed77",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kigo-$version.tar.xz"
                    }
                }
            ]
