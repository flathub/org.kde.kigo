                    }
                }
            ]
        },
        {
            "name": "kigo",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.3/src/kigo-26.04.3.tar.xz",
                    "sha256": "72894c8d6239ae182843a1cf5965d683a7bcea3092f4ec88e5602d2d7f05db4f",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kigo-$version.tar.xz"
                    }
                }
            ]
