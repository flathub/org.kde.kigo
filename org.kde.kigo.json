                }
            ]
        },
        {
            "name": "kigo",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kigo-26.08.3.tar.xz",
                    "sha256": "8be99d35778c62963b74d0b4d848817dc860648d5eccdeeb37e63b0e18ff6cdc",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kigo-$version.tar.xz"
